# Copy to .env and fill in.

# Pi-hole v6. Create an app password in Settings > Web interface / API
# ("Configure app password"), then paste it here.
PIHOLE_URL=http://192.168.0.2
PIHOLE_PASSWORD=
# Set to false if Pi-hole uses its self-signed certificate over https.
PIHOLE_VERIFY_TLS=true

# Local timezone, used for hour-of-day and quiet-hours panels.
TZ=America/Chicago

POSTGRES_PASSWORD=change-me
GRAFANA_DB_PASSWORD=change-me-too
GRAFANA_ADMIN_PASSWORD=admin

# Serving Grafana behind a reverse proxy at a sub-path (see README).
# Leave unset to serve Grafana directly at http://<server>:3000/.
#GRAFANA_ROOT_URL=http://server/pi-quiti/
#GRAFANA_SERVE_FROM_SUB_PATH=true
# 127.0.0.1 keeps port 3000 off the LAN so only the proxy can reach it.
#GRAFANA_BIND=127.0.0.1

# Collector tuning (defaults shown).
POLL_SECONDS=60
INITIAL_HOURS=24
SESSION_GAP_MINUTES=10
SESSION_TAIL_MINUTES=2
