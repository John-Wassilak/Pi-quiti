# Copy to .env and fill in.

# Pi-hole v6. Create an app password in Settings > Web interface / API
# ("Configure app password"), then paste it here.
PIHOLE_URL=http://192.168.0.2
PIHOLE_PASSWORD=
# Set to false if Pi-hole uses its self-signed certificate over https.
PIHOLE_VERIFY_TLS=true

# Local timezone, used for hour-of-day and quiet-hours panels.
TZ=America/Chicago

POSTGRES_PASSWORD=change-me
GRAFANA_DB_PASSWORD=change-me-too
GRAFANA_ADMIN_PASSWORD=admin

# Collector tuning (defaults shown).
POLL_SECONDS=60
INITIAL_HOURS=24
SESSION_GAP_MINUTES=10
SESSION_TAIL_MINUTES=2
